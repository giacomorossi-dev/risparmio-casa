{
  "name": "@rc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json && bun run scripts/emit-openapi.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/zod-openapi": "^1.4.0",
    "@rc/auth": "workspace:*",
    "@rc/config": "workspace:*",
    "@rc/db": "workspace:*",
    "@sentry/aws-serverless": "^10.54.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
