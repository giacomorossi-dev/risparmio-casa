# Offline dev (compose.yml)
DATABASE_URL=postgres://rc:rc@localhost:5432/risparmiocasa
SMTP_HOST=localhost
SMTP_PORT=1025

# Clerk (development instance — usa la dashboard Clerk per copiarli)
# CLERK_PUBLISHABLE_KEY: letta dal clerkMiddleware server (apps/web/src/start.ts), iniettata in SSR.
# VITE_CLERK_PUBLISHABLE_KEY: fallback esposto al client da Vite. Stesso valore.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Stub auth in modalità offline puro (no Clerk cloud)
OFFLINE_AUTH=0

# Sentry (lascia vuoto in dev)
SENTRY_DSN=

# AWS (solo per sst dev online; in offline non serve)
AWS_REGION=eu-south-1
